# --- Service principal (Terraform + local webapp -> Foundry auth) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Mock login for the local webapp (AUTH_MODE=mock, see webapp/backend/WebApp.Api/Program.cs) ---
MOCK_AUTH_USERNAME=
MOCK_AUTH_PASSWORD=

# AI_AGENT_ENDPOINT / AI_AGENT_ID / COSMOS_* are NOT set here — infra/scripts/create_agent.py
# writes those to infra/scripts/.generated.env (generated, gitignored) after `terraform apply`,
# loaded separately by docker-compose.yml. Never write to this file programmatically.
